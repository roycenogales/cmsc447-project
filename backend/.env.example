# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=retriever
POSTGRES_PASSWORD=change-me
POSTGRES_DB=retriever_essentials
# Use "db" inside docker compose, "localhost" when running the backend directly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# JSON list of origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=["http://localhost:5173"]
